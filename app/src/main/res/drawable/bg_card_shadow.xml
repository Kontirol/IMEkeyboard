<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 第1层：最外层淡阴影 -->
    <item android:left="0dp" android:top="3dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#06000000" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- 第2层 -->
    <item android:left="1dp" android:top="2dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#04000000" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- 第3层 -->
    <item android:left="2dp" android:top="1dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#02000000" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- 白色卡片主体 -->
    <item android:left="3dp" android:top="0dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_white" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
