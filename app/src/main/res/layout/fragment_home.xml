<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="كونتىرول كىرگۈزگۈچ"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <!-- 欢迎卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/blue_primary">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="كونتىرول كىرگۈزگۈچكە كەلگەنلىكىڭىزنى قارشى ئالىمىز"
                android:textSize="15sp"
                android:textColor="@color/white"
                android:padding="28dp"
                android:textDirection="rtl"
                android:gravity="start" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 开发者卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_shadow"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_person_outline"
                android:padding="8dp"
                android:background="@drawable/bg_icon_circle"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="تۈزگۈچى ھەققىدە"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="nijat (Ctrl) تەرىپىدىن ئىشلەپچىقىرىلغان"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <!-- 服务列表卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_card_shadow"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="14dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_star_outline"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مۇلازىمەتلىرىم"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/divider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="يانفون ئەپلىرى (iOS &amp; Android)"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:paddingVertical="12dp" />

            <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/divider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ئۈسكۈنە ئەپلىرى"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:paddingVertical="12dp" />

            <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/divider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="IT مەسلىھەتچىلىكى"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:paddingVertical="12dp" />
        </LinearLayout>

        <!-- 联系按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_contact"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="ئالاقىلىشىڭ"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_chat_outline"
            app:iconTint="@color/white"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            android:backgroundTint="@color/blue_primary"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </LinearLayout>
</ScrollView>
