<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/keyboard_background"
    android:padding="2dp">

    <!-- 候选词区域 -->
    <LinearLayout
        android:id="@+id/candidate_area"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@color/candidate_background"
        android:paddingHorizontal="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/candidate_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="18sp"
            android:textColor="@color/candidate_text_color"
            android:padding="4dp" />

        <TextView
            android:id="@+id/candidate_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="18sp"
            android:textColor="@color/candidate_text_color"
            android:padding="4dp" />

        <TextView
            android:id="@+id/candidate_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="18sp"
            android:textColor="@color/candidate_text_color"
            android:padding="4dp" />

    </LinearLayout>

    <!-- 键盘视图 -->
    <android.inputmethodservice.KeyboardView
        android:id="@+id/keyboard_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/keyboard_background"
        android:keyBackground="@drawable/key_background"
        android:keyTextColor="@color/key_text_color"
        android:keyTextSize="20sp"
        android:horizontalGap="2dp"
        android:verticalGap="2dp"
        android:popupLayout="@layout/keyboard_popup" />

</LinearLayout>